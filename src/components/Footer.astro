---
const today = new Date();
---

<footer>
	<div>&copy; {today.getFullYear()} sidequesting // built with too much coffee</div>
	<div><a href="#">GitHub</a> &middot; <a href="#">Instagram</a> &middot; <a href="/rss.xml">RSS</a></div>
</footer>
<style>
	footer {
		max-width: 1100px;
		margin: 0 auto;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding: 2rem clamp(1.5rem, 5vw, 3rem);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-dim);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	footer a {
		color: var(--text-dim);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--yellow);
	}
</style>
