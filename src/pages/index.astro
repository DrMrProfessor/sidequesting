---
import BaseHead from '../components/BaseHead.astro';
import BootSequence from '../components/BootSequence.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 6);

const bootLines = [
	{ text: 'sidequesting_os v2.077 — initialising...', delay: 300 },
	{ text: 'mounting /dev/curiosity', tone: 'ok' as const, delay: 250 },
	{ text: 'loading homelab modules ......... 12 services up', tone: 'ok' as const, delay: 250 },
	{ text: 'establishing tunnel → cloudflare', tone: 'ok' as const, delay: 250 },
	{ text: 'caffeine levels: CRITICAL', tone: 'warn' as const, delay: 300 },
	{ text: 'identity confirmed: DrMrProfessor', tone: 'ok' as const, delay: 250 },
	{ text: 'boot complete. welcome back.', delay: 400 },
];
---

<!doctype html>
<html lang="en-AU">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>

		<BootSequence lines={bootLines} />

		<main id="main-content">
			<div class="wrap">
				<nav aria-label="Primary">
					<a href="/" class="logo">side<span>questing</span>_</a>
					<div class="nav-links">
						<a href="/blog">Blog</a>
						<a href="/about">About</a>
					</div>
				</nav>

				<Hero
					tag="SYSTEM ONLINE // DrMrProfessor"
					titleLead="Side"
					titleGlitch="quests"
					titleTail="in "
					titleAccent="cyber"
					titleSuffix="."
					description="Homelab tinkering, security learning notes, and whatever rabbit hole I've fallen down this week. Building in public, one broken config at a time."
					primaryCta={{ label: 'Read the log', href: '/blog' }}
					secondaryCta={{ label: 'What I’m building', href: '/about' }}
				/>

				<section class="posts">
					<h2 class="section-label">Recent transmissions</h2>
					<div class="post-grid">
						{
							posts.map((post) => (
								<PostCard
									href={`/blog/${post.id}/`}
									date={post.data.pubDate}
									title={post.data.title}
									excerpt={post.data.description}
									tags={post.data.tags}
								/>
							))
						}
					</div>
				</section>

				<footer>
					<div>&copy; {new Date().getFullYear()} sidequesting // built with too much coffee</div>
					<div><a href="#">GitHub</a> &middot; <a href="#">Instagram</a> &middot; <a href="/rss.xml">RSS</a></div>
				</footer>
			</div>
		</main>
	</body>
</html>

<style>
	:global(*) {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		color-scheme: dark;
	}

	body {
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-display);
		min-height: 100vh;
		overflow-x: hidden;
		background-image:
			linear-gradient(var(--grid-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
		background-size: 40px 40px;
	}

	body::after {
		content: '';
		position: fixed;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(
			to bottom,
			transparent 0,
			transparent 2px,
			rgba(0, 0, 0, 0.15) 3px,
			transparent 4px
		);
		z-index: 9999;
		opacity: 0.4;
	}

	#main-content {
		/* Undo global.css's generic `main { width: 720px; ... }` rule, written
		   for the simple prose pages — this page's own .wrap div already
		   handles width/centring/padding at the intended 1100px. */
		width: auto;
		max-width: none;
		margin: 0;
		padding: 0;
		opacity: 0;
		visibility: hidden;
	}
	#main-content.reveal {
		animation: fadeUp 0.8s ease forwards;
		visibility: visible;
	}
	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.wrap {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 clamp(1.5rem, 5vw, 3rem);
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	.logo {
		font-weight: 700;
		font-size: 1.1rem;
		letter-spacing: 0.05em;
		color: var(--text);
		text-decoration: none;
	}
	.logo span {
		color: var(--yellow);
	}
	.nav-links {
		display: flex;
		gap: 2rem;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.nav-links a {
		color: var(--text-dim);
		text-decoration: none;
		transition: color 0.2s;
	}
	.nav-links a:hover {
		color: var(--cyan);
	}

	.posts {
		padding: 2rem 0 6rem;
	}
	.section-label {
		font-family: var(--font-mono);
		font-weight: 400;
		color: var(--yellow);
		font-size: 0.8rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		margin-bottom: 2rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.section-label::after {
		content: '';
		flex: 1;
		height: 1px;
		background: rgba(255, 255, 255, 0.08);
	}
	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 1.5rem;
	}

	footer {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding: 2rem 0;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-dim);
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
	}
	footer a {
		color: var(--text-dim);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--yellow);
	}
</style>
